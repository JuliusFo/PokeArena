<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Component tests with bUnit: rendering and interaction of the Razor components, no browser, no WebView. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- One copy of the update fakes for both suites (review 1.8.1, C15). -->
    <Compile Include="..\PokeArena.Core.Tests\Fakes\FakeUpdater.cs;..\PokeArena.Core.Tests\Fakes\FakeGate.cs" Link="Fakes\%(Filename)%(Extension)" />
    <None Include="..\..\data\*.json" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bunit" />
    <Using Include="Xunit" />
    <Using Include="PokeArena.UI.Tests.Fakes" />
    <Using Include="PokeArena.Core.Tests.Fakes" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PokeArena.UI\PokeArena.UI.csproj" />
  </ItemGroup>

</Project>
