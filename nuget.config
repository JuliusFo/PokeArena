<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come from nuget.org only. <clear /> drops feeds configured on the
     machine (e.g. DevExpress), which would otherwise also be queried and break
     the build with NU1507 under central package management. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
