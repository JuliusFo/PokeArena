@* Root component of the desktop app. *@
@inject AppInfo App

<div class="shell">
    <header class="topbar">
        <span class="brand">PokeArena</span>
        <span class="version">Version @App.Version</span>
    </header>

    <main class="content">
        <section class="card">
            <h1>Willkommen</h1>
            <p>Hier entsteht die Steuerzentrale für den PokeArena-Bot. Die Verbindung zu Twitch folgt im nächsten Schritt.</p>
        </section>
    </main>
</div>
