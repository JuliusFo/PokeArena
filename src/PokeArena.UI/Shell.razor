@* Root component of the desktop app. *@
@inject AppInfo App

<div class="shell">
    <header class="topbar">
        <span class="brand">PokeArena</span>
        <span class="version">Version @App.Version</span>
    </header>

    <main class="content">
        <div class="columns">
            <div class="column">
                <ConnectionPanel />
                <DryRunPanel />
            </div>
            <div class="column column-wide">
                <ChatLogPanel />
            </div>
        </div>
    </main>
</div>
