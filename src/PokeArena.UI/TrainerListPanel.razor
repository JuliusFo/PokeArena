@* All registered trainers, newest first, with a confirmed delete (spec §11). *@
@using PokeArena.Core.Chat
@using PokeArena.Core.Data
@using PokeArena.Core.Game
@implements IDisposable
@inject TrainerService Trainers
@inject TrainerRemoval Removal
@inject ChatInbox Inbox
@inject GameDatabase Database

<section class="card">
    <div class="card-head">
        <h2>Trainer</h2>
        <span class="count">@CountText</span>
        <input class="search" type="search" placeholder="Name suchen" aria-label="Name suchen" @bind="_search" @bind:event="oninput" />
    </div>

    @if (_sandbox)
    {
        <p class="hint">Probelauf: Hier stehen nur Testtrainer. Sie verschwinden, sobald der Probelauf endet.</p>
    }

    @if (_trainers is null)
    {
        <p class="hint">Lade …</p>
    }
    else if (_trainers.Count == 0)
    {
        <p class="hint">Noch niemand registriert. Zuschauer machen mit <strong>!registrieren &lt;Starter&gt;</strong> mit.</p>
    }
    else if (Visible.Count == 0)
    {
        <p class="hint">Niemand passt zu „@_search“.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Starter</th>
                    <th class="num">Pokémon</th>
                    <th class="num">Orden</th>
                    <th class="num">Tokens</th>
                    <th>Dabei seit</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var trainer in Visible)
                {
                    <tr>
                        <td class="strong">@trainer.DisplayName</td>
                        <td>@trainer.Starter.Name</td>
                        <td class="num">@trainer.SpecimenCount</td>
                        <td class="num">@trainer.Badges</td>
                        <td class="num">@trainer.Tokens</td>
                        <td>@trainer.RegisteredAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="num"><button class="btn btn-quiet delete" @onclick="() => _confirming = trainer">Löschen</button></td>
                    </tr>
                    @if (_confirming?.TwitchUserId == trainer.TwitchUserId)
                    {
                        <tr class="confirm-delete">
                            <td colspan="7">
                                <strong>@trainer.DisplayName wirklich löschen?</strong>
                                Alle Pokémon, Erfolge und Orden sind danach weg, auf der Website wird der Name in alten
                                Kämpfen zu „[gelöscht]“. Das lässt sich nicht rückgängig machen.
                                <div class="actions">
                                    <button class="btn btn-danger" @onclick="() => Delete(trainer)">Ja, löschen</button>
                                    <button class="btn btn-quiet" @onclick="() => _confirming = null">Abbrechen</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</section>

@code {
    private IReadOnlyList<TrainerSummary>? _trainers;
    private string _search = "";
    private bool _sandbox;
    private TrainerSummary? _confirming;

    private IReadOnlyList<TrainerSummary> Visible =>
        string.IsNullOrWhiteSpace(_search)
            ? _trainers ?? []
            : (_trainers ?? []).Where(t => t.DisplayName.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    private string CountText => _trainers is null ? "" : _trainers.Count == 1 ? "1 Trainer" : $"{_trainers.Count} Trainer";

    protected override async Task OnInitializedAsync()
    {
        Trainers.Changed += OnChanged;
        await ReloadAsync();
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    /// <summary>On the command queue like every game change; the list reloads via <see cref="TrainerService.Changed"/>.</summary>
    private void Delete(TrainerSummary trainer)
    {
        _confirming = null;
        Inbox.Post(new QueuedWork("Trainer löschen", ct => Removal.DeleteAsync(trainer.TwitchUserId, ct)));
    }

    private async Task ReloadAsync()
    {
        _sandbox = Database.IsSandbox;
        _trainers = await Trainers.ListAsync(CancellationToken.None);
    }

    public void Dispose() => Trainers.Changed -= OnChanged;
}
