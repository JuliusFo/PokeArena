@*
    The trainer page's Pokédex (claude/pokedex-trainer-page-improve-a4a504): all species as a list — caught, seen
    („gesehen“, greyed with a mark) and unknown („????????“) — next to a box with the selected one. Names, types and
    base values of species the trainer has not caught come from arten.json; without it (between the release and the
    bot's update) the list shows the caught ones from the trainer file alone and the box no base values.
    „Alle / Nur gefangene“ is kept per viewer in localStorage (ViewerSettings.PokedexViewKey).
*@
@implements IAsyncDisposable
@inject IJSRuntime JS
@using Microsoft.JSInterop

<div class="dex-head">
    <h2>Pokédex</h2>
    <div class="view-switch" role="group" aria-label="Welche Pokémon">
        <button type="button" aria-pressed="@(_onlyCaught ? "false" : "true")" @onclick="() => SetOnlyCaughtAsync(false)">Alle</button>
        <button type="button" aria-pressed="@(_onlyCaught ? "true" : "false")" @onclick="() => SetOnlyCaughtAsync(true)">Nur gefangene</button>
    </div>
</div>

@{ var rows = Rows().ToList(); }
<div class="dex">
    <div class="dex-list">
        <div class="dex-columns">
            <span class="dex-number">#</span>
            @if (_searching)
            {
                <span @ref="_searchBox" class="dex-search">
                    <input @ref="_searchField" type="text" autocomplete="off" placeholder="Name oder Nummer" aria-label="Pokédex durchsuchen"
                           @bind="_query" @bind:event="oninput" @onkeydown="OnSearchKeyAsync" />
                    <button type="button" class="dex-search-close" aria-label="Suche schließen" @onclick="() => CloseSearch(returnFocus: true)">×</button>
                </span>
            }
            else
            {
                @* Hidden feature (viewer request): a click on „Name“ turns it into a search. The label keeps the word
                   „Name“ first, so speech input still finds it. *@
                <button @ref="_searchOpener" type="button" class="dex-search-open" title="Suchen" aria-label="Name – Suche öffnen"
                        @onclick="OpenSearch">Name</button>
            }
            <span class="dex-count">Anzahl</span>
        </div>
        <ul class="dex-rows">
            @foreach (var row in rows)
            {
                var selected = row.Id == _selected;
                <li @key="row.Id" class="dex-row @row.Kind.ToString().ToLowerInvariant() @(selected ? "selected" : null)">
                    @if (row.Kind == RowKind.Unknown)
                    {
                        <div class="dex-pick">
                            <span class="dex-number">@Number(row.Id)</span>
                            <span class="dex-unknown"><span aria-hidden="true">????????</span><span class="visually-hidden">unbekannt</span></span>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="dex-pick" aria-current="@(selected ? "true" : null)" @onclick="() => _selected = row.Id">
                            <span class="dex-number">@Number(row.Id)</span>
                            <span class="dex-name">
                                <SpeciesName Species="row.Species!" />
                                @if (row.Kind == RowKind.Seen)
                                {
                                    <span class="dex-seen">gesehen</span>
                                }
                                @if (row.Entry?.HasStarter == true)
                                {
                                    <span class="chip">Starter</span>
                                }
                            </span>
                            <span class="dex-count">@(row.Entry is { Count: > 1 } entry ? $"× {entry.Count}" : null)</span>
                        </button>
                    }
                </li>
                @if (selected)
                {
                    <li class="dex-inline">@Detail(row)</li>
                }
            }
            @if (rows.Count == 0)
            {
                <li class="dex-empty">Kein Pokémon gefunden.</li>
            }
        </ul>
    </div>
    @* Only while its row is in the list: a filter or search that hides it hides the box too, like on a phone. *@
    <div class="dex-box" aria-live="polite">
        @if (rows.FirstOrDefault(r => r.Id == _selected) is { } current)
        {
            @Detail(current)
        }
        else
        {
            <p class="muted">Klick auf ein Pokémon in der Liste.</p>
        }
    </div>
</div>

@code {
    /// <summary>
    /// The last species of Gen 1. Fixed, never taken from the files: they come from the data host, and an id from
    /// there must not set how many rows the page draws (review: an id of 2³¹ − 1 would never end the loop).
    /// </summary>
    private const int LastSpecies = 151;

    private static readonly IReadOnlyList<(string Label, Func<SpeciesData, int> Value)> BaseValues =
    [
        ("HP", s => s.Hp),
        ("ATK", s => s.Atk),
        ("DEF", s => s.Def),
        ("SPEZ", s => s.Spez),
    ];

    private Dictionary<int, PokedexEntry> _caught = [];
    private Dictionary<int, SpeciesData> _species = [];
    private HashSet<int> _seen = [];
    private int? _selected;
    private bool _onlyCaught;
    private bool _picked;
    private bool _searching;
    private bool _focusSearch;
    private bool _focusOpener;
    private bool _openedByKeyboard;
    private bool _watchingOutside;
    private string _query = "";
    private ElementReference _searchBox;
    private ElementReference _searchField;
    private ElementReference _searchOpener;
    private DotNetObjectReference<Pokedex>? _self;
    private TrainerPage? _shownFor;

    [Parameter, EditorRequired]
    public TrainerPage Trainer { get; set; } = null!;

    /// <summary>arten.json; null while it is missing.</summary>
    [Parameter]
    public SpeciesList? Species { get; set; }

    private enum RowKind
    {
        Caught,
        Seen,
        Unknown,
    }

    private sealed record Row(int Id, RowKind Kind, SpeciesInfo? Species, PokedexEntry? Entry, SpeciesData? Data);

    /// <summary>
    /// Builds the list before the stored pick is read: in WASM <c>getItem</c> answers later, and Blazor renders once in
    /// between — without this, 151 unknown rows and an empty box (review).
    /// </summary>
    protected override void OnInitialized() => OnParametersSet();

    /// <summary>
    /// The viewer's last pick, for every trainer page. Storage may be blocked: the Pokédex then starts with „Alle“ and
    /// the switch still works until the page is left. A click before the browser answers wins.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var stored = await ViewerSettings.OnlyCaughtAsync(JS);
        if (!_picked)
        {
            _onlyCaught = stored;
        }
    }

    private async Task SetOnlyCaughtAsync(bool onlyCaught)
    {
        _picked = true;
        _onlyCaught = onlyCaught;
        await ViewerSettings.SavePokedexViewAsync(JS, onlyCaught);
    }

    protected override void OnParametersSet()
    {
        // Both files come from the data host: the JSON reader does not enforce non-null fields, so an entry without a
        // name or types, or outside Gen 1, is left out instead of breaking the page (review).
        _caught = (Trainer.Pokedex ?? [])
            .Where(e => e?.Species is { Name: not null, Types: not null } s && s.Types.All(t => t is not null) && InRange(s.Id))
            .GroupBy(e => e.Species.Id)
            .ToDictionary(g => g.Key, g => g.First());
        _species = (Species?.Species ?? [])
            .Where(s => s is { Name: not null, Types: not null } && s.Types.All(t => t is not null) && InRange(s.Id))
            .GroupBy(s => s.Id)
            .ToDictionary(g => g.Key, g => g.First());

        // A seen species needs its name from arten.json; without it, it stays unknown.
        _seen = [.. (Trainer.Seen ?? []).Where(id => _species.ContainsKey(id) && !_caught.ContainsKey(id))];
        if (!ReferenceEquals(_shownFor, Trainer))
        {
            // Another trainer (or a new load): start at their first catch.
            _shownFor = Trainer;
            _selected = _caught.Count == 0 ? null : _caught.Keys.Min();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSearch)
        {
            _focusSearch = false;
            await _searchField.FocusAsync();
        }
        else if (_focusOpener)
        {
            // The field is gone after „×“ or Escape: keyboard users continue where the search started.
            _focusOpener = false;
            await _searchOpener.FocusAsync();
        }

        if (_searching != _watchingOutside)
        {
            await WatchOutsideAsync(_searching);
        }
    }

    /// <summary>
    /// A tap on free space closes an empty search (index.html, <c>pokeArenaDex</c>). Without the script (an old cached
    /// index.html) the search still closes with „×“ and Escape.
    /// </summary>
    private async Task WatchOutsideAsync(bool watch)
    {
        _watchingOutside = watch;
        try
        {
            if (watch)
            {
                _self ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("pokeArenaDex.watchOutside", _searchBox, _self);
            }
            else
            {
                await JS.InvokeVoidAsync("pokeArenaDex.unwatch");
            }
        }
        catch (JSException)
        {
        }
    }

    /// <summary>
    /// A tap on free space closes an empty search only: with a query typed, it is often meant to hide a phone's keyboard,
    /// and the results stay (review). The tap put the focus where it wanted it: no jump back to „Name“.
    /// </summary>
    [JSInvokable]
    public Task CloseFromOutside() => InvokeAsync(() =>
    {
        if (!_searching || !string.IsNullOrWhiteSpace(_query))
        {
            return;
        }

        _searching = false;
        _query = "";
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        if (_watchingOutside)
        {
            try
            {
                await JS.InvokeVoidAsync("pokeArenaDex.unwatch");
            }
            catch (Exception e) when (e is JSException or JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }

    private IEnumerable<Row> Rows()
    {
        var query = _query.Trim();
        for (var id = 1; id <= LastSpecies; id++)
        {
            var row = Find(id)!;
            if (_onlyCaught && row.Kind != RowKind.Caught)
            {
                continue;
            }

            if (query.Length > 0 && !Matches(row, query))
            {
                continue;
            }

            yield return row;
        }
    }

    /// <summary>
    /// Name or number — of caught and seen species only: arten.json holds every name, and the search must not reveal
    /// the unknown ones.
    /// </summary>
    private static bool Matches(Row row, string query)
    {
        if (row.Kind == RowKind.Unknown)
        {
            return false;
        }

        var number = query.TrimStart('#');
        return int.TryParse(number, NumberStyles.None, CultureInfo.InvariantCulture, out var id) && number.Length > 0
            ? id == row.Id
            : row.Species!.Name.Contains(query, StringComparison.CurrentCultureIgnoreCase);
    }

    private Row? Find(int? id)
    {
        if (id is not { } key)
        {
            return null;
        }

        _species.TryGetValue(key, out var data);
        if (_caught.TryGetValue(key, out var entry))
        {
            return new Row(key, RowKind.Caught, entry.Species, entry, data);
        }

        return _seen.Contains(key)
            ? new Row(key, RowKind.Seen, new SpeciesInfo(key, data!.Name, data.Types), null, data)
            : new Row(key, RowKind.Unknown, null, null, null);
    }

    private RenderFragment Detail(Row row) => __builder =>
    {
        <h3>@row.Species!.Name</h3>
        <p class="dex-types">
            @foreach (var type in row.Species.Types)
            {
                <span class="type @Format.TypeClass(type)">@type</span>
            }
            @if (row.Entry?.HasStarter == true)
            {
                <span class="chip">Starter</span>
            }
            @if (row.Entry is { Count: > 1 } entry)
            {
                <span class="muted">× @entry.Count</span>
            }
        </p>
        @if (row.Kind == RowKind.Seen)
        {
            <p class="muted">Schon im Kampf gesehen, aber noch nicht gefangen.</p>
        }
        else if (row.Data is { } data)
        {
            <h4>Basiswerte</h4>
            <dl class="dex-values">
                @foreach (var (label, value) in BaseValues)
                {
                    <div><dt>@label</dt><dd>@value(data)</dd></div>
                }
            </dl>
        }
    };

    private static bool InRange(int id) => id is >= 1 and <= LastSpecies;

    private static string Number(int id) => "#" + id.ToString("000", CultureInfo.InvariantCulture);

    /// <summary>Enter or Space on a button fire a click with <c>detail</c> 0; a mouse or a tap counts from 1.</summary>
    private void OpenSearch(MouseEventArgs e)
    {
        _searching = true;
        _focusSearch = true;
        _openedByKeyboard = e.Detail == 0;
    }

    /// <summary>
    /// „×“ always puts the focus back on „Name“ (the button is gone; screen readers would start at the top). Escape does
    /// only when the search was opened with the keyboard: a focus moved by script after a key draws the browser's focus
    /// ring, which a mouse user sees as a stray frame (user feedback, review).
    /// </summary>
    private void CloseSearch(bool returnFocus)
    {
        _searching = false;
        _query = "";
        _focusOpener = returnFocus;
    }

    private void OnSearchKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseSearch(returnFocus: _openedByKeyboard);
        }
    }
}
