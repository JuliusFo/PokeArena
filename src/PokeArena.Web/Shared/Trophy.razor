@*
    Small trophy before ranks 1–3 on the leaderboard: gold, silver, bronze (feat/leaderboard-trophies). Own drawing,
    no emoji (they look different on every system) and no official asset (ADR-0008). Decorative: the rank number next
    to it carries the information, so screen readers skip it. Shared ranks share the trophy.
*@
@if (Rank is >= 1 and <= 3)
{
    <svg class="trophy rank-@Rank" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path class="handles" d="M7 5H4v1.5a4 4 0 0 0 3.8 4M17 5h3v1.5a4 4 0 0 1-3.8 4" />
        <path class="cup" d="M6.5 3h11v5.5a5.5 5.5 0 0 1-11 0z" />
        <path class="cup" d="M10.8 14h2.4v3.5h-2.4zM7.5 17.5h9a1 1 0 0 1 1 1V21h-11v-2.5a1 1 0 0 1 1-1z" />
    </svg>
}

@code {
    [Parameter, EditorRequired]
    public int Rank { get; set; }
}
