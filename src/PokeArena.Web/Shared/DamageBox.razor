@* The „Schaden“ box under the fight cards (feat/damage-meter); nothing for files written before the damage was stored. *@

@if (DamageMeter.For(Battle) is { } board)
{
    <section class="damage">
        <h2>Schaden</h2>
        <h3>Gesamt</h3>
        <BarList Bars="board.Totals" />
        <h3>@board.RankingTitle</h3>
        <BarList Bars="board.Ranking" Ordered />
    </section>
}

@code {
    [Parameter, EditorRequired]
    public BattlePage Battle { get; set; } = null!;
}
