@* An HP bar with its numbers inside (site.css `.hp-bar`): two copies of the text, each clipped to its part of the bar –
   dark over the empty rest, white over the fill. The fight cards and every hit in the fight log share it (review 1.8.1,
   B1), so a fix reaches both. *@
<span class="@Class" style="@Style" title="@Title"><span class="hp-text">@if (HiddenPrefix is { } prefix)
{<span class="visually-hidden">@prefix</span>}@Text</span> <span class="hp-text on-fill" aria-hidden="true">@Text</span></span>

@code {
    /// <summary>`hp-bar` plus modifiers such as `hit-bar` or `no-loss`.</summary>
    [Parameter, EditorRequired]
    public string Class { get; set; } = "hp-bar";

    /// <summary>At least `--hp: <percent>%` and `--hp-color` (HpColor.Fill); numbers only, never text from a file.</summary>
    [Parameter, EditorRequired]
    public string Style { get; set; } = "";

    [Parameter, EditorRequired]
    public string Text { get; set; } = "";

    [Parameter]
    public string? Title { get; set; }

    /// <summary>Read by screen readers before the numbers (e.g. „HP “), invisible otherwise.</summary>
    [Parameter]
    public string? HiddenPrefix { get; set; }
}
