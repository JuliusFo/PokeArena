@inherits LayoutComponentBase
@implements IDisposable
@inject SiteData Data

<div class="page">
    <header class="site-header">
        <a class="brand" href="">PokeArena</a>
        <nav>
            <NavLink href="" Match="NavLinkMatch.All">Rangliste</NavLink>
            <NavLink href="kaempfe">Kämpfe</NavLink>
            <NavLink href="statistik">Statistik</NavLink>
            <NavLink href="anleitung">So geht's</NavLink>
            <NavLink href="neuigkeiten">Neuigkeiten</NavLink>
        </nav>
    </header>

    @if (_newerData)
    {
        <p class="notice" role="status">Es gibt eine neue Version der Seite. Bitte lade sie neu.</p>
    }
    else if (_olderData)
    {
        <p class="notice" role="status">Die Daten werden gerade umgestellt. Manches fehlt vielleicht kurz – schau später noch einmal vorbei.</p>
    }

    <main>
        @Body
    </main>

    <footer class="site-footer">
        <p>
            PokeArena ist ein nicht-kommerzielles Fan-Projekt für einen Twitch-Kanal und steht in keiner Verbindung zu
            Nintendo, Game Freak, Creatures oder The Pokémon Company. Pokémon und alle Namen sind Marken ihrer Inhaber.
        </p>
        <p><a href="datenschutz">Datenschutz</a></p>
    </footer>
</div>

@code {
    private readonly CancellationTokenSource _stop = new();
    private bool _newerData;
    private bool _olderData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await Data.MetaAsync(_stop.Token) is { } meta)
            {
                _newerData = meta.FormatVersion > SiteMeta.CurrentFormatVersion;

                // The normal order after a format change: the site deploys on merge, the bot follows with the next
                // update of the streamer's app (review 1.0.3, A33).
                _olderData = meta.FormatVersion < SiteMeta.CurrentFormatVersion;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException || (ex is OperationCanceledException && !_stop.IsCancellationRequested))
        {
            // The pages show their own hint when the data host is unreachable.
        }
    }

    public void Dispose()
    {
        _stop.Cancel();
        _stop.Dispose();
    }
}
