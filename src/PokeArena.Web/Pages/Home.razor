@page "/"
@inherits PollingPage

<PageTitle>Rangliste – PokeArena</PageTitle>

<h1>Rangliste</h1>

@if (Loading)
{
    <p class="muted">Lädt …</p>
}
else if (_leaderboard is null ? !Failed : _leaderboard.Entries.Count == 0)
{
    <p>Noch niemand dabei. Schreib im Chat <strong>!registrieren</strong> und such dir dein erstes Pokémon aus!</p>
}
else if (_leaderboard is not null)
{
    <p class="muted">
        @_leaderboard.PlayerCount Trainer · Stand @Format.Moment(_leaderboard.UpdatedAt, Now) ·
        Es zählen verschiedene Arten, bei Gleichstand alle Pokémon.
    </p>
    <table class="table">
        <thead>
            <tr>
                <th class="num">Platz</th>
                <th>Trainer</th>
                <th class="num">Arten</th>
                <th class="num">Pokémon</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in _leaderboard.Entries)
            {
                <tr class="@(entry.Rank <= 3 ? "top" : "")">
                    <td class="num">@entry.Rank</td>
                    <td>
                        @{ var tint = Tint.Style(entry.Color); }
                        @* The tint on the link itself, so the underline takes the name's colour too. *@
                        <a href="trainer/@entry.TrainerId" class="trainer-link@(tint is null ? null : " tinted")" style="@tint">
                            @if (Data.ProfileImageUrl(entry.ProfileImage) is { } image)
                            {
                                @* Lazy: a few hundred rows. A file that is gone keeps its place, so the names stay aligned. *@
                                <img class="profile-image small" src="@image" alt="" width="24" height="24" loading="lazy" onerror="this.style.visibility='hidden'" />
                            }
                            else
                            {
                                <span class="profile-image small" aria-hidden="true"></span>
                            }
                            <span>@entry.DisplayName</span>
                        </a>
                    </td>
                    <td class="num strong">@entry.Distinct</td>
                    <td class="num">@entry.Total</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Failed)
{
    <LoadFailed />
}

@code {
    private Leaderboard? _leaderboard;

    protected override async Task LoadAsync(CancellationToken ct) => _leaderboard = await Data.LeaderboardAsync(ct);
}
