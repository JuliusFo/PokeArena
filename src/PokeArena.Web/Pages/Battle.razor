@page "/kampf/{Id:long}"
@implements IDisposable
@inject SiteData Data
@inject TimeProvider Time

<PageTitle>@(_battle?.Headline ?? "Kampf") – PokeArena</PageTitle>

@if (_battle is { } battle)
{
    <p class="muted">
        <span class="battle-kind kind-@battle.Kind.ToString().ToLowerInvariant()">@BattleList.KindName(battle.Kind)</span>
        @Format.DateTime(battle.FoughtAt)
    </p>
    <h1>@battle.Headline</h1>
    <p class="result">@battle.Result</p>

    <div class="sides">
        @foreach (var side in battle.Sides)
        {
            <section class="side @(side.Won ? "won" : "lost")">
                <h2>@side.Name@(side.Won ? " – gewonnen" : "")</h2>
                <ul class="fighters">
                    @foreach (var fighter in side.Fighters)
                    {
                        var state = EndState(fighter);
                        <li class="fighter-@state">
                            @* Name and owner wrap inside their own box, so the end state keeps its column on the right. *@
                            <span class="who">
                                <SpeciesName Species="fighter.Species" />
                                @if (fighter.TrainerId is { } trainerId && fighter.Owner != side.Name)
                                {
                                    var tint = Tint.Style(fighter.Color);
                                    <a href="trainer/@trainerId" class="@(tint is null ? null : "tinted")" style="@tint">@fighter.Owner</a>
                                }
                            </span>
                            <span class="end-state">
                                @switch (state)
                                {
                                    case "survived":
                                        @* The numbers sit inside the bar to save width. Two copies, each clipped to its part of the
                                           bar (site.css): dark over the empty rest, white over the fill. *@
                                        var hpText = $"{fighter.HpLeft} / {fighter.MaxHp} HP";
                                        <span class="hp-bar@(fighter.HpLeft * 4 <= fighter.MaxHp ? " low" : "")" style="--hp: @HpPercent(fighter)%">
                                            <span class="hp-text">@hpText</span>
                                            <span class="hp-text on-fill" aria-hidden="true">@hpText</span>
                                        </span>
                                        break;
                                    case "fainted":
                                        <span>besiegt</span>
                                        break;
                                    case "unused":
                                        <span>nicht eingesetzt</span>
                                        break;
                                    default:
                                        <span>@fighter.MaxHp HP</span>
                                        break;
                                }
                            </span>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>

    <h2>Kampfverlauf</h2>
    <ol class="log">
        @if (battle.Log is { } log)
        {
            @foreach (var line in log)
            {
                <li class="@(line.IsRound ? "round" : null)">
                    @foreach (var part in line.Parts)
                    {
                        // Text may be missing in a file that is not ours (no null check in SiteJson): plain text then.
                        if (part.IsCritical && (part.Text ?? "").TrimStart() is { Length: > 0 } word)
                        {
                            // The leading space stays outside the gold background.
                            var space = part.Text![..^word.Length];
                            @space
                            <strong class="critical">@word</strong>
                        }
                        else if (FighterOf(battle, part) is { } fighter && Tint.Style(Tint.Of(battle, part, fighter)) is { } tint)
                        {
                            <span class="tinted" style="@tint">@part.Text</span>
                        }
                        else
                        {
                            @part.Text
                        }
                    }
                </li>
            }
        }
        else
        {
            @* Files written before the log had parts. *@
            @foreach (var line in battle.Lines)
            {
                <li class="@(line.StartsWith("Runde ", StringComparison.Ordinal) ? "round" : null)">@line</li>
            }
        }
    </ol>
    <p class="muted">Seed @battle.Seed.ToString(CultureInfo.InvariantCulture)</p>
}
else if (_gaveUp && _failed)
{
    <h1>Kampf</h1>
    <LoadFailed Retrying="false" />
}
else if (_gaveUp)
{
    <h1>Kampf nicht gefunden</h1>
    <p>
        Diesen Kampf gibt es (noch) nicht. Wurde er gerade erst gekämpft, lade die Seite in ein paar Minuten neu.
        <a href="kaempfe">Zu den letzten Kämpfen</a>
    </p>
}
else if (_failed)
{
    <h1>Kampf</h1>
    <LoadFailed />
}
else
{
    <h1>Kampf wird gerade veröffentlicht …</h1>
    <p class="muted">Der Kampf ist gleich da – die Seite lädt ihn von selbst.</p>
}

@code {
    /// <summary>A link from chat may arrive before the upload (spec §9): retry this often …</summary>
    public static readonly TimeSpan RetryInterval = TimeSpan.FromSeconds(3);

    /// <summary>… for this long, then the fight does not exist.</summary>
    public static readonly TimeSpan GiveUpAfter = TimeSpan.FromMinutes(2);

    private readonly CancellationTokenSource _stop = new();
    private BattlePage? _battle;
    private bool _failed;
    private bool _gaveUp;

    [Parameter]
    public long Id { get; set; }

    /// <summary>„survived“, „fainted“, „unused“, or „unknown“ for files written before the end state existed.</summary>
    private static string EndState(BattleFighter fighter) => fighter switch
    {
        { Used: false } => "unused",
        { HpLeft: 0 } => "fainted",
        { HpLeft: > 0 } => "survived",
        _ => "unknown",
    };

    /// <summary>The fighter a log part names, or null (plain text, or an index the page does not have).</summary>
    private static BattleFighter? FighterOf(BattlePage battle, LogPart part) =>
        part is { Side: { } side, Fighter: { } index } && side >= 0 && side < battle.Sides.Count &&
        index >= 0 && index < battle.Sides[side].Fighters.Count
            ? battle.Sides[side].Fighters[index]
            : null;

    private static string HpPercent(BattleFighter fighter) =>
        (100.0 * (fighter.HpLeft ?? 0) / Math.Max(1, fighter.MaxHp)).ToString("0.#", CultureInfo.InvariantCulture);

    protected override async Task OnParametersSetAsync()
    {
        _battle = null;
        _gaveUp = false;
        var until = Time.GetUtcNow() + GiveUpAfter;
        try
        {
            while (true)
            {
                try
                {
                    _battle = await Data.BattleAsync(Id, _stop.Token);
                    _failed = false;
                }
                catch (Exception ex) when (ex is HttpRequestException || (ex is OperationCanceledException && !_stop.IsCancellationRequested))
                {
                    // Host unreachable, rate limit or a HttpClient timeout: not „the fight does not exist“.
                    _failed = true;
                }

                if (_battle is not null)
                {
                    return;
                }

                if (Time.GetUtcNow() >= until)
                {
                    _gaveUp = true;
                    return;
                }

                StateHasChanged();
                await Task.Delay(RetryInterval, Time, _stop.Token);
            }
        }
        catch (OperationCanceledException)
        {
            // Page left.
        }
    }

    public void Dispose()
    {
        _stop.Cancel();
        _stop.Dispose();
    }
}
