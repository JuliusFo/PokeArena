@page "/kampf/{Id:long}"
@implements IDisposable
@inject SiteData Data
@inject TimeProvider Time
@inject IJSRuntime JS
@using Microsoft.JSInterop

<PageTitle>@(_battle?.Headline ?? "Kampf") – PokeArena</PageTitle>

@if (_battle is { } battle)
{
    <p class="muted">
        <span class="battle-kind kind-@battle.Kind.ToString().ToLowerInvariant()">@BattleList.KindName(battle.Kind)</span>
        @Format.DateTime(battle.FoughtAt)
    </p>
    <h1>@battle.Headline</h1>
    <p class="result">@battle.Result</p>

    <div class="sides">
        @foreach (var side in battle.Sides)
        {
            <section class="side @(side.Won ? "won" : "lost")">
                <h2>@side.Name@(side.Won ? " – gewonnen" : "")</h2>
                <ul class="fighters">
                    @foreach (var fighter in side.Fighters)
                    {
                        var state = EndState(fighter);
                        <li class="fighter-@state">
                            @* Name and owner wrap inside their own box, so the end state keeps its column on the right. *@
                            <span class="who">
                                <SpeciesName Species="fighter.Species" />
                                @if (fighter.TrainerId is { } trainerId && fighter.Owner != side.Name)
                                {
                                    var tint = Tint.Style(fighter.Color);
                                    <a href="trainer/@trainerId" class="@(tint is null ? null : "tinted")" style="@tint">@fighter.Owner</a>
                                }
                            </span>
                            <span class="end-state">
                                @switch (state)
                                {
                                    case "survived":
                                        @* The numbers sit inside the bar to save width. *@
                                        <HpBar Class="@("hp-bar" + BarLevel(fighter.HpLeft ?? 0, fighter.MaxHp))"
                                               Style="@($"--hp: {HpPercent(fighter)}%")"
                                               Text="@($"{fighter.HpLeft} / {fighter.MaxHp} HP")" />
                                        break;
                                    case "fainted":
                                        <span>besiegt</span>
                                        break;
                                    case "unused":
                                        <span>nicht eingesetzt</span>
                                        break;
                                    default:
                                        <span>@fighter.MaxHp HP</span>
                                        break;
                                }
                            </span>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>

    <DamageBox Battle="battle" />

    <div class="log-head">
        <h2>Kampfverlauf</h2>
        @if (battle.Log?.Any(l => l.Hit is not null) == true)
        {
            @* Viewers disagreed on the hit bars: each picks a view, the browser remembers it (claude/kampflog-design-options-cb7042). *@
            <div class="view-switch" role="group" aria-label="Ansicht des Kampfverlaufs">
                <button type="button" aria-pressed="@(_textView ? "false" : "true")" @onclick="() => SetViewAsync(textView: false)">Balken</button>
                <button type="button" aria-pressed="@(_textView ? "true" : "false")" @onclick="() => SetViewAsync(textView: true)">Text</button>
            </div>
        }
    </div>
    <ol class="log">
        @if (battle.Log is { } log)
        {
            @foreach (var line in log)
            {
                <li class="@(line.IsRound ? "round" : null)">
                    @if (_textView && TargetOf(battle, line) is { } textTarget)
                    {
                        @TextParts(battle, line, textTarget)
                    }
                    else if (TargetOf(battle, line) is { } target)
                    {
                        @* The target's HP move from the sentence into a bar on the right (claude/hp-balken-kampf-log-mockup-de3cfe): the
                           fill up to the HP after the hit, the lost piece hatched up to the HP before it. The damage moves
                           from the sentence to the bar's left (claude/kampflog-hp-balken-feedback-808390, mockup „A“), so
                           a hit's numbers are in one place; older files without it keep it in the sentence. *@
                        var hit = line.Hit!;
                        @* The number is the hit's full damage: a knockout of 77 on 70 HP left shows −77 next to 70 → 0, so
                           an overkill stays visible; the bar shows what arrived, the „Schaden“ box counts only that
                           (user decision 2026-11-27 after viewer feedback, reverting the cap of 1.8.2). *@
                        int? damage = hit.Damage is >= 0 ? hit.Damage : null;
                        var hpText = $"{hit.Before} → {hit.After}";
                        var barClass = "hp-bar hit-bar" + BarLevel(hit.After, target.MaxHp) + (hit.Before == hit.After ? " no-loss" : "");
                        <span class="hit">
                            <span class="hit-text">@Parts(battle, line, withoutTargetHp: true, damageAtBar: damage is not null)</span>
                            <span class="hit-numbers">
                                @if (damage is { } dealt)
                                {
                                    @* „Schaden“ for screen readers and a copied line, like the bar's „HP“. *@
                                    <span class="hit-damage"><span class="visually-hidden">@(" ")</span>−@dealt.ToString(CultureInfo.InvariantCulture)<span class="visually-hidden">@(" Schaden, ")</span></span>
                                }
                                @* „HP“ for screen readers, who would otherwise hear only „80 Pfeil 22“ (review). *@
                                <HpBar Class="@barClass"
                                       Style="@($"--hp: {Percent(hit.After, target.MaxHp)}%; --before: {Percent(hit.Before, target.MaxHp)}%")"
                                       Title="@($"HP {hpText} von {target.MaxHp}")"
                                       HiddenPrefix="HP "
                                       Text="@hpText" />
                            </span>
                        </span>
                    }
                    else
                    {
                        @Parts(battle, line, withoutTargetHp: false, damageAtBar: false)
                    }
                </li>
            }
        }
        else
        {
            @* Files written before the log had parts. *@
            @foreach (var line in battle.Lines)
            {
                <li class="@(line.StartsWith("Runde ", StringComparison.Ordinal) ? "round" : null)">@line</li>
            }
        }
    </ol>
    <p class="muted">Seed @battle.Seed.ToString(CultureInfo.InvariantCulture)</p>
}
else if (_gaveUp && _failed)
{
    <h1>Kampf</h1>
    <LoadFailed Retrying="false" />
}
else if (_gaveUp)
{
    <h1>Kampf nicht gefunden</h1>
    <p>
        Diesen Kampf gibt es (noch) nicht. Wurde er gerade erst gekämpft, lade die Seite in ein paar Minuten neu.
        <a href="kaempfe">Zu den letzten Kämpfen</a>
    </p>
}
else if (_failed)
{
    <h1>Kampf</h1>
    <LoadFailed />
}
else
{
    <h1>Kampf wird gerade veröffentlicht …</h1>
    <p class="muted">Der Kampf ist gleich da – die Seite lädt ihn von selbst.</p>
}

@code {
    /// <summary>A link from chat may arrive before the upload (spec §9): retry this often …</summary>
    public static readonly TimeSpan RetryInterval = TimeSpan.FromSeconds(3);

    /// <summary>… for this long, then the fight does not exist.</summary>
    public static readonly TimeSpan GiveUpAfter = TimeSpan.FromMinutes(2);

    private readonly CancellationTokenSource _stop = new();
    private BattlePage? _battle;
    private bool _failed;
    private bool _gaveUp;

    [Parameter]
    public long Id { get; set; }

    /// <summary>„survived“, „fainted“, „unused“, or „unknown“ for files written before the end state existed.</summary>
    private static string EndState(BattleFighter fighter) => fighter switch
    {
        { Used: false } => "unused",
        { HpLeft: 0 } => "fainted",
        { HpLeft: > 0 } => "survived",
        _ => "unknown",
    };

    /// <summary>The fighter at a page position, or null for a position the page does not have (a file not ours).</summary>
    private static BattleFighter? FighterAt(BattlePage battle, int side, int index) =>
        side >= 0 && side < battle.Sides.Count && index >= 0 && index < battle.Sides[side].Fighters.Count
            ? battle.Sides[side].Fighters[index]
            : null;

    /// <summary>The fighter a log part names, or null (plain text, or an index the page does not have).</summary>
    private static BattleFighter? FighterOf(BattlePage battle, LogPart part) =>
        part is { Side: { } side, Fighter: { } index } ? FighterAt(battle, side, index) : null;

    private static string HpPercent(BattleFighter fighter) => Percent(fighter.HpLeft ?? 0, fighter.MaxHp);

    private static string Percent(int hp, int max) =>
        (100.0 * Math.Clamp(hp, 0, Math.Max(1, max)) / Math.Max(1, max)).ToString("0.#", CultureInfo.InvariantCulture);

    /// <summary>
    /// The fighter a hit's bar belongs to, or null: no hit (other lines, older files), or values the page cannot draw
    /// (an index or HP that is not ours) — the line then shows its full text as before.
    /// </summary>
    private static BattleFighter? TargetOf(BattlePage battle, LogLine line) =>
        line.Hit is { } hit && FighterAt(battle, hit.Side, hit.Fighter) is { MaxHp: > 0 } fighter &&
        hit.After >= 0 && hit.After <= hit.Before && hit.Before <= fighter.MaxHp
            ? fighter
            : null;

    /// <summary>
    /// A log line's parts: names in their colour, „Volltreffer!“ on gold, the target's HP left out where a bar shows
    /// them, the attacker's HP coloured like in the text view there (claude/hp-coloring-bar-view-4f3c63, viewer
    /// feedback), and each part's <see cref="LogPart.TextWithBar"/> where the damage stands next to the bar. A line the
    /// page cannot draw keeps its sentence as written, uncoloured HP included.
    /// </summary>
    private static RenderFragment Parts(BattlePage battle, LogLine line, bool withoutTargetHp, bool damageAtBar) => __builder =>
    {
        foreach (var part in line.Parts)
        {
            if (withoutTargetHp && part.IsTargetHp)
            {
                continue;
            }

            if (withoutTargetHp && AttackerHp(battle, part) is (var hp, var max))
            {
                @Hp(hp, max)
                continue;
            }

            // Text may be missing in a file that is not ours (no null check in SiteJson): plain text then.
            @Part(battle, part, damageAtBar && part.TextWithBar is { } withBar ? withBar : part.Text ?? "")
        }
    };

    /// <summary>
    /// An attacker's HP part („24“ of „Pikachu (Ash, HP 24)“) with its fighter's maximum; null for any other part, and
    /// for a number the page cannot read (a file not ours) — that part stays plain text.
    /// </summary>
    private static (int Hp, int Max)? AttackerHp(BattlePage battle, LogPart part) =>
        part.IsHp && FighterOf(battle, part) is { MaxHp: > 0 } fighter &&
        int.TryParse(part.Text, NumberStyles.None, CultureInfo.InvariantCulture, out var hp) && hp <= fighter.MaxHp
            ? (hp, fighter.MaxHp)
            : null;

    /// <summary>One part: „Volltreffer!“ on gold, a name in its colour, anything else as plain text.</summary>
    private static RenderFragment Part(BattlePage battle, LogPart part, string text) => __builder =>
    {
        if (part.IsCritical && text.TrimStart() is { Length: > 0 } word)
        {
            // The leading space stays outside the gold background.
            var space = text[..^word.Length];
            @space
            <strong class="critical">@word</strong>
        }
        else if (FighterOf(battle, part) is { } fighter && Tint.Style(Tint.Of(battle, part, fighter)) is { } tint)
        {
            <span class="tinted" style="@tint">@text</span>
        }
        else
        {
            @text
        }
    };

    /// <summary>
    /// A hit in the text view (claude/kampflog-design-options-cb7042, viewer feedback on the bars): the whole sentence
    /// „Pikachu (Ash, HP 24) trifft Schiggy (Misty, HP 88 → 30) und verursacht 58 Schaden.“ with the HP coloured by
    /// what is left and the damage in bold red. The damage is the hit's full damage, like the bar view's number (an
    /// overkill shows, user decision 2026-11-27); a file with a foreign damage falls back to what arrived. A file
    /// without a marked damage (1.8.2 and older) keeps its own wording; only the target's HP get their colour there.
    /// </summary>
    private static RenderFragment TextParts(BattlePage battle, LogLine line, BattleFighter target) => __builder =>
    {
        var hit = line.Hit!;
        var reworded = line.Parts.Any(p => p.IsDamage);
        foreach (var part in line.Parts)
        {
            if (part.IsTargetHp)
            {
                @(", HP ")
                @Hp(hit.Before, target.MaxHp)
                @(" → ")
                @Hp(hit.After, target.MaxHp)
            }
            else if (reworded && part.IsDamage)
            {
                @(" und verursacht ")
                <strong class="log-damage">@((hit.Damage is >= 0 and var full ? full : hit.Before - hit.After).ToString(CultureInfo.InvariantCulture))</strong>
                @(" Schaden.")
            }
            else if (AttackerHp(battle, part) is (var hp, var max))
            {
                @Hp(hp, max)
            }
            else
            {
                @Part(battle, part, reworded && part.TextWithBar is { } withBar ? withBar : part.Text ?? "")
            }
        }
    };

    /// <summary>
    /// How much is left: „low“ (red) at a quarter or less, „mid“ (orange) at half or less, „high“ (green) above. Bars and
    /// text share the steps; the bars had no „mid“ before claude/hp-coloring-bar-view-4f3c63 (viewer feedback).
    /// In <see cref="long"/>: a file not ours with HP near <see cref="int.MaxValue"/> must not wrap into red (review).
    /// </summary>
    private static string Level(int hp, int max) => (long)hp * 4 <= max ? "low" : (long)hp * 2 <= max ? "mid" : "high";

    /// <summary>A bar's class modifier: „ low“, „ mid“, or nothing for the default green fill.</summary>
    private static string BarLevel(int hp, int max) => Level(hp, max) switch { "high" => "", var level => " " + level };

    /// <summary>HP as coloured text: the target's in the text view, the attacker's in both views.</summary>
    private static RenderFragment Hp(int hp, int max) => __builder =>
    {
        <span class="log-hp @Level(hp, max)">@hp.ToString(CultureInfo.InvariantCulture)</span>
    };

    private bool _textView;

    /// <summary>
    /// The viewer's last pick, here or on „Einstellungen“. Storage may be blocked (private windows, strict settings): the
    /// page then starts with the bars and the switch still works until the page is left.
    /// </summary>
    protected override async Task OnInitializedAsync() => _textView = await ViewerSettings.TextViewAsync(JS);

    private async Task SetViewAsync(bool textView)
    {
        _textView = textView;
        await ViewerSettings.SaveLogViewAsync(JS, textView);
    }

    protected override async Task OnParametersSetAsync()
    {
        _battle = null;
        _gaveUp = false;
        var until = Time.GetUtcNow() + GiveUpAfter;
        try
        {
            while (true)
            {
                try
                {
                    _battle = await Data.BattleAsync(Id, _stop.Token);
                    _failed = false;
                }
                catch (Exception ex) when (ex is HttpRequestException || (ex is OperationCanceledException && !_stop.IsCancellationRequested))
                {
                    // Host unreachable, rate limit or a HttpClient timeout: not „the fight does not exist“.
                    _failed = true;
                }

                if (_battle is not null)
                {
                    return;
                }

                if (Time.GetUtcNow() >= until)
                {
                    _gaveUp = true;
                    return;
                }

                StateHasChanged();
                await Task.Delay(RetryInterval, Time, _stop.Token);
            }
        }
        catch (OperationCanceledException)
        {
            // Page left.
        }
    }

    public void Dispose()
    {
        _stop.Cancel();
        _stop.Dispose();
    }
}
