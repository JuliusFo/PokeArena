<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Thin WPF host: generic host, logging, window chrome and the BlazorWebView. The UI lives in PokeArena.UI (ADR-0007). -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- BlazorWebView's WebView2CompositionControl needs the WinRT projection; with plain net10.0-windows the app
         crashes at startup (known from FerretSharp). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PokeArena.Desktop</RootNamespace>
    <AssemblyName>PokeArena</AssemblyName>
    <!-- Per-monitor DPI awareness, see the comment in the manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Own Main (Program.cs): Velopack must run before anything else (WP-11, ADR-0010). -->
    <StartupObject>PokeArena.Desktop.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml as a page, so WPF does not generate a second Main. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel for the local OBS overlay (spec §9). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Overlay\overlay.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Framework.Win32.CredentialManager" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PokeArena.Core\PokeArena.Core.csproj" />
    <ProjectReference Include="..\PokeArena.UI\PokeArena.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Versioned base data (species, type chart, NPCs), shipped next to the program (ADR-0005). -->
    <None Include="..\..\data\*.json" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Optional, git-ignored developer overrides such as the test channel. Never part of a release package. -->
    <!-- The Razor SDK makes *.json Content items, so this is a Content update, not None. -->
    <Content Update="appsettings.local.json" Condition="Exists('appsettings.local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
